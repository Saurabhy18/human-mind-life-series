# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# credentials (Google service-account keys, private keys) — keep them outside the project
*service-account*.json
*credentials*.json
*.p12
*.key

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# private data: orders database, payment screenshots, book PDFs
/storage/
# database files and downloaded backups anywhere in the project (never commit customer data)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# alternative build folders used for testing (NEXT_DIST_DIR)
/.next-*/
# Environment secrets
.env
.env.*
!.env.example

# Dependencies and build
node_modules/
.next/
out/
dist/

# Local database and sensitive data
.db
.db-shm
.db-wal