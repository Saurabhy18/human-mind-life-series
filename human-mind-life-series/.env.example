# Copy to .env.local (or run `npm run setup-admin`, which creates it with the admin values filled in).
# On Hostinger: hPanel → your website → Environment variables (add them one by one, or "Import .env").
# NEVER commit .env.local or share these values. Placeholders only in this file.
# Variables starting with NEXT_PUBLIC_ (and PAYMENT_PROVIDER) are read at BUILD time: redeploy/rebuild after changing them.

# =============================================================================
#  REQUIRED
# =============================================================================

# Your live address, https and no trailing slash. Used for canonical URLs, sitemap, robots.txt,
# share images and email links. Replace YOUR-DOMAIN.com with your real domain.
NEXT_PUBLIC_SITE_URL=https://YOUR-DOMAIN.com

# Admin login. Generate BOTH with: npm run setup-admin  (never put the plain password here)
# Hashed admin password (format scrypt:<salt>:<hash>)
ADMIN_PASSWORD_HASH=
# Random secret, 64+ characters. Signs admin sessions and download links.
SESSION_SECRET=

# Checkout mode. manual_upi = UPI QR + payment reference + screenshot, verified by you in /admin.
# none = checkout closed (the code default if this is missing). cashfree = Cashfree hosted checkout (leave off until approved).
PAYMENT_PROVIDER=manual_upi

# =============================================================================
#  RECOMMENDED
# =============================================================================

# Private data folder: orders.db, payment screenshots, book PDFs, generated books.
# Must be persistent, writable by the app, and NOT inside public_html, public/, .next/ or hbuilds/.
# Default: ./storage — or, on Hostinger Node.js hosting, /home/<user>/domains/<domain>/storage (detected automatically).
# Setting it explicitly is safest. Hostinger example:
# STORAGE_DIR=/home/u123456789/domains/YOUR-DOMAIN.com/storage

# =============================================================================
#  OPTIONAL
# =============================================================================

# ----------------------------------------------------------- Site / links --
# Address used in emails. Defaults to NEXT_PUBLIC_SITE_URL.
# FRONTEND_URL=https://YOUR-DOMAIN.com
# Prices and bundles are NOT set here — see src/config/packages.ts. Contact details, UPI ID: src/config/site.config.ts.

# ------------------------------------------------------ Ads & Analytics --
# Public IDs (not secrets). Empty = that script is off. Can also be set in src/config/site.config.ts.
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXX

# ----------------------------------------------------------------- Email --
# Without SMTP the site still works; you send links manually from /admin.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="The Human Mind & Life Series <books@YOUR-DOMAIN.com>"

# ---------------------------------------------- Google Cloud Translation --
# Leave GOOGLE_CLOUD_PROJECT_ID empty to sell English only (the normal bookstore needs nothing here).
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=global
# Credentials: a service-account JSON key stored OUTSIDE the project and public folders, e.g.
# GOOGLE_APPLICATION_CREDENTIALS=/home/u123456789/domains/YOUR-DOMAIN.com/secrets/google-key.json
# Translated editions are offered ONLY when this is true. Leave false until a real translation has been checked end to end.
TRANSLATION_SALES_ENABLED=false
# document = Google Document Translation, keeps the PDF layout ($0.08/page). text = needs Chromium (not on Hostinger shared/Business).
TRANSLATION_STRATEGY=document
# true = run the translation worker inside the website process (needed on Hostinger Business/Cloud,
# which runs one process). On a VPS run `npm run worker` as a second process instead.
# RUN_WORKER_IN_SERVER=true
# DOC_TRANSLATION_PAGES_PER_REQUEST=100      # ≤ 300 (native PDFs), each request ≤ 20 MB
# TEXT_TRANSLATION_CHARS_PER_REQUEST=5000    # Google recommends ≤ 5,000
# TRANSLATION_MAX_ATTEMPTS=3
# TRANSLATION_RETRY_BASE_SECONDS=30          # backoff: 30s, 60s, 120s…
# LANGUAGES_CACHE_HOURS=24
# CHROMIUM_PATH=                             # only for TRANSLATION_STRATEGY=text
# WORKER_POLL_SECONDS=3
# WORKER_LEASE_MINUTES=30

# -------------------------------------------- Cashfree (OFF by default) --
# Used only when PAYMENT_PROVIDER=cashfree. Create credentials in the Cashfree Merchant Dashboard
# (Developers → API Keys). Use SANDBOX credentials first; switch to production only when ready.
# CASHFREE_ENV=sandbox            # sandbox (default) or production. production is honoured ONLY when NODE_ENV=production.
CASHFREE_CLIENT_ID=
CASHFREE_SECRET_KEY=
# Optional: pin the API version (default 2023-08-01).
# CASHFREE_API_VERSION=2023-08-01
#
# Webhook: in the Cashfree Dashboard → Developers → Webhooks, add this endpoint and subscribe to
# PAYMENT_SUCCESS_WEBHOOK, PAYMENT_FAILED_WEBHOOK and PAYMENT_USER_DROPPED_WEBHOOK:
#   https://YOUR-DOMAIN.com/api/payment/webhook
# Cashfree signs webhooks with your CASHFREE_SECRET_KEY (no separate webhook secret is needed).

# ------------------------------------------------- Storage & downloads --
# local (default) = the private STORAGE_DIR on this server. gcs = private Google Cloud Storage bucket.
# STORAGE_DRIVER=local
# BOOK_STORAGE_BUCKET=
# DOWNLOAD_URL_TTL_SECONDS=600       # each signed download link
# DOWNLOAD_ACCESS_HOURS=48           # how long a customer can download after the book is ready (per book)
# MAX_DOWNLOADS_PER_ORDER=5          # per book (a 3-book bundle gets 5 downloads of each book)
# DOWNLOAD_SIGNING_SECRET=           # defaults to SESSION_SECRET (min 32 chars)
