# Copy to .env.local (or run `npm run setup-admin`, which creates it for you).
# NEVER commit .env.local or share these values. Restart the site and the worker after changes.

# ------------------------------------------------------------------ Admin --
# Hashed admin password — generate with: npm run setup-admin
ADMIN_PASSWORD_HASH=
# Random secret (64+ characters) used to sign admin sessions — generated by setup-admin
SESSION_SECRET=

# Where orders.db, payment screenshots, private book PDFs and translated books are stored.
# Defaults to ./storage. Must be on a persistent disk and NOT inside /public.
# STORAGE_DIR=/var/data/human-mind-storage

# Your live site address (used in email links). Defaults to SITE_URL in site.config.ts.
FRONTEND_URL=https://your-domain.com
# BACKEND_URL is the same as FRONTEND_URL for this app (one Next.js server).

# ---------------------------------------------- Google Cloud Translation --
# Leave GOOGLE_CLOUD_PROJECT_ID empty to sell English only (language dropdown hidden).
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=global
# Credentials: Application Default Credentials. Locally run `gcloud auth application-default login`.
# In production use a service account (GOOGLE_APPLICATION_CREDENTIALS=/path/key.json) or workload identity.
# GOOGLE_APPLICATION_CREDENTIALS=
# document = Google Document Translation, keeps the original PDF layout ($0.08/page).
# text     = extract → translate → rebuild ($20 per million characters, first 500K/month free).
TRANSLATION_STRATEGY=document
# DOC_TRANSLATION_PAGES_PER_REQUEST=100      # ≤ 300 (native PDFs), each request ≤ 20 MB
# TEXT_TRANSLATION_CHARS_PER_REQUEST=5000    # Google recommends ≤ 5,000
# TRANSLATION_MAX_ATTEMPTS=3
# TRANSLATION_RETRY_BASE_SECONDS=30          # backoff: 30s, 60s, 120s…
# LANGUAGES_CACHE_HOURS=24
# Chromium/Chrome used by the "text" strategy to build PDFs (e.g. /usr/bin/chromium on Linux).
# CHROMIUM_PATH=

# --------------------------------------------------------------- Payments --
# manual_upi (default) = your UPI QR + admin verification.  razorpay = hosted checkout + signed webhook.
PAYMENT_PROVIDER=manual_upi
# Outside production ONLY test-mode keys (rzp_test_…) are accepted, so local testing can never charge real money.
# Live keys (rzp_live_…) work only on the production server (NODE_ENV=production).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set the same secret in Razorpay Dashboard → Webhooks (events: payment.captured, order.paid, payment.failed)
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------- Storage & downloads --
# local (default) = private folder on this server. gcs = private Google Cloud Storage bucket.
# STORAGE_DRIVER=local
BOOK_STORAGE_BUCKET=
# DOWNLOAD_URL_TTL_SECONDS=600       # each signed download link
# DOWNLOAD_ACCESS_HOURS=48           # how long a customer can download after the book is ready
# MAX_DOWNLOADS_PER_ORDER=5
# DOWNLOAD_SIGNING_SECRET=           # defaults to SESSION_SECRET (min 32 chars)

# ----------------------------------------------------------------- Email --
# Without SMTP the site still works; the admin sends links manually.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="The Human Mind & Life Series <books@your-domain.com>"

# ---------------------------------------------------------------- Worker --
# WORKER_POLL_SECONDS=3
# WORKER_LEASE_MINUTES=30
